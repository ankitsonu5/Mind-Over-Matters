# =============================================================================
#  Backend environment — copy this file to `.env` and fill in the values
# =============================================================================

PORT=5000
NODE_ENV=development

# --- Database -----------------------------------------------------------------
# Leave MONGODB_URI empty to run on the local JSON files in ./data-store
# Remember to percent-encode special characters in the password (@ -> %40)
MONGODB_URI=
MONGODB_DB=mom

# --- Admin login --------------------------------------------------------------
# Used only to seed the very first admin user when the database is empty
ADMIN_USER=admin
ADMIN_PASSWORD=change-me
AUTH_SECRET=change-me-to-a-long-random-string

# Legacy /panel page password (x-admin-key header)
ADMIN_PANEL_PASSWORD=change-me

# --- Which frontend origins may call this API ---------------------------------
# Comma separated. Use * to allow everything (development only).
CORS_ORIGINS=http://localhost:3000

# Set to "none" only when the frontend is on a DIFFERENT domain and you rely
# on cookie auth. Requires HTTPS on both sides.
COOKIE_SAMESITE=lax

# --- Email notifications (optional) -------------------------------------------
RESEND_API_KEY=
NOTIFY_EMAIL_TO=
NOTIFY_EMAIL_FROM=Mind Over Matter <onboarding@resend.dev>
