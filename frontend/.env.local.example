# =============================================================================
#  Frontend environment — copy this file to `.env.local`
# =============================================================================

# Where the Express backend is running.
#   - Server components fetch this URL directly
#   - Browser requests to /api/* are proxied here by next.config.mjs
# Local development:
BACKEND_URL=http://localhost:5000
# Production example:
# BACKEND_URL=https://mom-api.onrender.com
